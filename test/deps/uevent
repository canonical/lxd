#!/usr/bin/env python3
"""Send a synthetic USB uevent to LXD's netlink listener.

The properties match those of a kernel uevent. The message is sent to netlink
group 2, where udev publishes events after rule processing. LXD listens on that
group and treats messages without the libudev header as kernel uevents, so the
event follows the kernel hotplug path without being processed by udevd.
"""

import argparse
import socket

# Linux netlink protocol for kernel object uevents (linux/netlink.h).
NETLINK_KOBJECT_UEVENT = 15

# udev publishes processed events to this multicast group. LXD listens on it
# and treats messages without the libudev header as kernel uevents.
UEVENT_GROUP = 2


def hex_int(value):
    return int(value, 16)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("add", "remove"))
    parser.add_argument("--vendor", type=hex_int, default=0xdead)
    parser.add_argument("--product", type=hex_int, default=0xbeef)
    parser.add_argument("--bus", type=int, default=9)
    parser.add_argument("--dev", type=int, default=99)
    parser.add_argument("--major", type=int, default=189)
    parser.add_argument("--minor", type=int, default=99)
    args = parser.parse_args()

    props = [
        f"ACTION={args.action}",
        f"DEVPATH=/devices/virtual/usb-test/{args.bus}-{args.dev}",
        "SUBSYSTEM=usb",
        "SEQNUM=1",
        f"MAJOR={args.major}",
        f"MINOR={args.minor}",
        f"DEVNAME=bus/usb/{args.bus:03d}/{args.dev:03d}",
        "DEVTYPE=usb_device",
        "DRIVER=usb",
        f"PRODUCT={args.vendor:x}/{args.product:x}/100",
        "TYPE=0/0/0",
        f"BUSNUM={args.bus:03d}",
        f"DEVNUM={args.dev:03d}",
    ]
    message = b"\0".join(prop.encode() for prop in props) + b"\0"

    sock = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_KOBJECT_UEVENT)
    try:
        sock.bind((0, 0))
        sock.sendto(message, (0, UEVENT_GROUP))
    finally:
        sock.close()


if __name__ == "__main__":
    main()
