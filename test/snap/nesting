#!/bin/bash
# shellcheck disable=SC1091 # Runtime-resolved path; intentionally not followed.
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../local-snap.sh" || return 1
set -eux

# Install LXD
install_lxd

# Configure LXD
lxc network create lxdbr0
lxc profile device add default eth0 nic network=lxdbr0

IMAGE="${TEST_IMG:-ubuntu-minimal-daily:24.04}"

test_nesting_container() {
    echo "Skipping container nesting tests on ${LXD_SNAP_CHANNEL}, not supported"
    return 0
}

test_nesting_vm() {
    echo "==> Running nesting test for vm"

    # VMs on 4.0 are more resource intensive and slower to boot
    export MAX_WAIT_SECONDS=240

    local VMs=3
    local nestedVMs=2
    local storageDriver="zfs"
    local instCount

    if ! hasSupportedStorageDriver zfs; then
        storageDriver="lvm"
        echo "ZFS storage driver is not supported, falling back to ${storageDriver}"
    fi

    lxc project switch default
    lxc storage create default "${storageDriver}" size=30GiB

    function parallel() {
        seq "$1" | xargs -P "$1" -I "{}" "${@:2}"
    }

    function init() {
        vm="${2:-}"
        if [ -z "${vm}" ]
        then
            parallel "$1" lxc init "${IMAGE}" "t{}" -s default -n lxdbr0 --quiet
        else
            parallel "$1" lxc init "${IMAGE}" "t{}" "${vm}" -s default -n lxdbr0 --quiet
        fi
    }

    function conf() {
        # Supports setting multiple key=value pairs in a single call.
        parallel "$1" lxc config set "t{}" "${@:2}"
    }

    function start() {
        instances=()
        for i in $(seq "$1"); do
            instances["$i"]="t$i"
        done

        echo "Start ${instances[*]}"
        lxc start "${instances[@]}"
    }

    function wait() {
        for i in $(seq "$1"); do
            waitInstanceReady "t${i}"
            setup_instance_gocoverage "t${i}"
        done
    }

    function cmd() {
        parallel "$1" lxc exec "t{}" -- bash -c "$2"
    }

    function delete() {
        instances=()
        for i in $(seq "$1"); do
            instances["$i"]="t$i"
            prepare_vm_for_hard_stop "t$i"
        done

        echo "Delete ${instances[*]}"
        lxc delete -f "${instances[@]}"
    }

    echo "==> Test ${VMs} VMs in parallel"
    init "${VMs}" --vm
    start "${VMs}"
    delete "${VMs}"

    echo "==> Test ${VMs} VMs in parallel for vsock ID collision"
    init "${VMs}" --vm
    conf "${VMs}" volatile.vsock_id=42
    start "${VMs}"
    delete "${VMs}"

    echo "==> Test ${nestedVMs} VMs each with one nested VM"
    init "${nestedVMs}" --vm
    start "${nestedVMs}"
    wait "${nestedVMs}"

    cmd "${nestedVMs}" "$(declare -f waitSnapdSeed); waitSnapdSeed"
    cmd "${nestedVMs}" "snap install lxd --channel ${LXD_SNAP_CHANNEL}"
    cmd "${nestedVMs}" "lxd init --auto"
    cmd "${nestedVMs}" "lxc profile device set default root size=3584MiB"
    cmd "${nestedVMs}" "lxc launch ${IMAGE} nested --vm -c limits.memory=512MiB --quiet"
    delete "${nestedVMs}"

    echo "Skipping VM in container tests on ${LXD_SNAP_CHANNEL}"

    echo "==> Cleaning up"
    instCount="$(lxc list -f csv -c n t | wc -l)"
    [ "$instCount" -gt 0 ] && delete "${instCount}"

    lxc storage delete default
}

# Allow for running a specific set of tests.
if [ "$#" -gt 0 ]; then
    for test_name in "$@"; do
        case "${test_name}" in
            container|nesting-container|test_container|test_nesting_container)
                test_nesting_container
                ;;
            vm|nesting-vm|test_vm|test_nesting_vm)
                test_nesting_vm
                ;;
            *)
                echo "Unknown test: ${test_name}" >&2
                exit 1
                ;;
        esac
    done
else
    test_nesting_container
    test_nesting_vm
fi

echo "==> Cleaning up environment"
lxc profile device remove default eth0
lxc network delete lxdbr0

# shellcheck disable=SC2034
FAIL=0
