#!/bin/bash
# shellcheck disable=SC1091 # Runtime-resolved path; intentionally not followed.
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../local-snap.sh" || return 1
set -eux

# Kubernetes cluster name used as a prefix for LXD and k8s resources.
CLUSTER_NAME="${1:-lxd-csi}"

echo "==> Install LXD"
install_lxd
lxd init --auto

echo "==> Install dependencies"
install_deps git squashfs-tools

if ! command -v kubectl > /dev/null; then
    snap install kubectl --classic
fi

if ! command -v helm > /dev/null; then
    snap install helm --classic
fi

if ! command -v go > /dev/null; then
    snap install go --classic
fi

echo "==> Clone lxd-csi-driver"
if [ -d lxd-csi-driver ]; then
    rm -rf lxd-csi-driver
fi

git clone --depth=1 --single-branch https://github.com/canonical/lxd-csi-driver.git

echo "==> Deploy Kubernetes cluster with LXD CSI driver"
LXD_CI_HELPERS_PATH="$(realpath test/includes/snap-helpers.sh)"
K8S_KUBECONFIG_PATH="$(realpath lxd-csi-driver)/.kube/${CLUSTER_NAME}.yml"

export LXD_CI_HELPERS_PATH
export K8S_KUBECONFIG_PATH
export K8S_CLUSTER_NAME="${CLUSTER_NAME}"
export K8S_SNAP_CHANNEL="${K8S_SNAP_CHANNEL:-latest/edge}"
export K8S_CSI_IMAGE_TAG="${K8S_CSI_IMAGE_TAG:-latest-edge}"
export K8S_NODE_COUNT="${K8S_NODE_COUNT:-2}"

# Reuse the cached Ubuntu 24.04 minimal VM image when available instead of pulling it fresh.
if [ -n "${IMAGE_CACHE_DIR:-}" ] && [ -f "${IMAGE_CACHE_DIR}/ubuntu.metadata" ] && [ -f "${IMAGE_CACHE_DIR}/ubuntu.img" ]; then
    echo "==> Import cached Ubuntu VM image"
    if ! lxc image alias list -f csv ubuntu-vm | grep '^ubuntu-vm,' >/dev/null; then
        if lxc image import --quiet "${IMAGE_CACHE_DIR}/ubuntu.metadata" "${IMAGE_CACHE_DIR}/ubuntu.img" --alias ubuntu-vm; then
            export LXD_INSTANCE_IMAGE="ubuntu-vm"
        fi
    else
        export LXD_INSTANCE_IMAGE="ubuntu-vm"
    fi
fi

# Populate and wire CSI-specific caches (k8s snap + base) when enabled.
if [ -n "${CSI_CACHE_DIR:-}" ]; then
    mkdir -p "${CSI_CACHE_DIR}/snaps"

    k8s_snap_dir="${CSI_CACHE_DIR}/snaps/k8s/${K8S_SNAP_CHANNEL/\//-}"
    k8s_snap="$(compgen -G "${k8s_snap_dir}/k8s_*.snap" | head -n1 || true)"
    if [ -z "${k8s_snap}" ] || [ ! -f "${k8s_snap%.snap}.assert" ]; then
        if SNAP_CACHE_DIR="${CSI_CACHE_DIR}/snaps" download_snap k8s "${K8S_SNAP_CHANNEL}"; then
            k8s_snap="$(compgen -G "${k8s_snap_dir}/k8s_*.snap" | head -n1 || true)"
        else
            echo "Warning: Failed to pre-download k8s snap (${K8S_SNAP_CHANNEL}); will fall back to store" >&2
        fi
    fi

    if [ -n "${k8s_snap}" ] && command -v unsquashfs >/dev/null; then
        k8s_yaml="$(unsquashfs -n -cat "${k8s_snap}" meta/snap.yaml)"
        k8s_base="$(awk '/^base:/ {print $2; exit}' <<< "${k8s_yaml}")"
        if [ -n "${k8s_base}" ] && [ "${k8s_base}" != "bare" ]; then
            base_dir="${CSI_CACHE_DIR}/snaps/${k8s_base}/latest-candidate"
            base_snap="$(compgen -G "${base_dir}/${k8s_base}_*.snap" | head -n1 || true)"
            if [ -z "${base_snap}" ] || [ ! -f "${base_snap%.snap}.assert" ]; then
                shared_base_dir="${SNAP_CACHE_DIR:-}/${k8s_base}/latest-candidate"
                if [ -n "${SNAP_CACHE_DIR:-}" ] && compgen -G "${shared_base_dir}/${k8s_base}_*.snap" >/dev/null; then
                    mkdir -p "${base_dir}"
                    cp -a "${shared_base_dir}/${k8s_base}_"* "${base_dir}/"
                elif ! SNAP_CACHE_DIR="${CSI_CACHE_DIR}/snaps" download_snap "${k8s_base}" "latest/candidate"; then
                    echo "Warning: Failed to pre-download ${k8s_base} snap; will fall back to store" >&2
                fi
            fi
        fi
    fi

    export K8S_SNAP_CACHE_DIR="${CSI_CACHE_DIR}/snaps"
fi

bash lxd-csi-driver/.github/actions/setup-k8s/k8s.sh deploy

if [ -n "${CSI_CACHE_DIR:-}" ]; then
    # Ensure files created as root (notably 0600 .snap files) are readable by actions/cache/save.
    chmod -R a+rX "${CSI_CACHE_DIR}"
fi

echo "==> Install ginkgo test runner"
(
    cd lxd-csi-driver
    go install github.com/onsi/ginkgo/v2/ginkgo@"$(go list -m -f '{{.Version}}' github.com/onsi/ginkgo/v2)"
)

echo "==> Run e2e tests"
PATH="$(go env GOPATH)/bin:${PATH}"

export PATH
export TEST_LXD_STORAGE_DRIVERS="${TEST_LXD_STORAGE_DRIVERS:-dir,btrfs,zfs,lvm}"

(cd lxd-csi-driver/test/e2e && ginkgo -v --timeout 60m .)

echo "==> Cleanup"
bash lxd-csi-driver/.github/actions/setup-k8s/k8s.sh cleanup

# shellcheck disable=SC2034
FAIL=0
