#!/bin/bash
# shellcheck disable=SC1091 # Runtime-resolved path; intentionally not followed.
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../local-snap.sh" || return 1
set -eux

# Integration test verifying that Canonical products relying on LXD keep working
# with it. It accepts an optional list of products to test as arguments.
# When no arguments are provided, all supported products are tested.
if [ "${#}" -gt 0 ]; then
    products=("${@}")
else
    products=(pylxd)
fi

# test_pylxd: run the pylxd client integration test suite against LXD.
test_pylxd() {
    if [ ! -d pylxd ]; then
        command -v git || install_deps git
        git clone --depth=1 https://github.com/canonical/pylxd
    fi

    (
        cd pylxd
        export DEBIAN_FRONTEND=noninteractive
        export HOME=/root
        integration/run-integration-tests
    )
}

# Install and setup LXD.
install_lxd
lxd init --auto

for product in "${products[@]}"; do
    case "${product}" in
        snapcraft|workshop|charmcraft)
            echo "Skipping ${product}, not supported on LXD 5.21"
            ;;
        pylxd)
            test_pylxd
            ;;
        *)
            echo "Unknown product: ${product}" >&2
            exit 1
            ;;
    esac
done

# shellcheck disable=SC2034
FAIL=0
