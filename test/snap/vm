#!/bin/bash
# shellcheck disable=SC1091 # Runtime-resolved path; intentionally not followed.
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../local-snap.sh" || return 1
set -eux

# Install LXD
install_lxd

# Configure LXD
lxd init --auto

IMAGE="${TEST_IMG:-ubuntu-minimal-daily:24.04}"

echo "==> Create test instance"
lxc init "${IMAGE}" v1 --vm

echo "==> Ensure aliased image can launch without VM flag set"
lxc image alias create vmalias "$(lxc config get v1 volatile.base_image)"
lxc launch vmalias v2
lxc delete -f v2
lxc image alias delete vmalias

echo "==> Start test instance"
lxc start v1
waitInstanceBooted v1
setup_instance_gocoverage v1

echo "==> Test cleanly stopping a VM"
lxc stop v1

if ! [[ "${LXD_SNAP_CHANNEL}" =~ ^4\.0/ ]]; then
    echo "==> Test lxc exec exit code upon VM disconnection due to a stop/reboot"
    lxc start v1
    waitInstanceBooted v1

    echo "==> Test getting the correct exit code for a signaled process"
    # Signaling the process spawned by lxc exec and checking its exit code.
    # Simulates what can happen if the VM stops in the middle of lxc exec.
    for signal in SIGTERM SIGHUP SIGKILL; do
        echo "==> Test getting the correct exit code when sending ${signal} to an exec'ed process"
        code="$(kill -l "${signal}")"
        unset exitCode
        # killall is not included in minimal images so we use escaping to combine pgrep and kill.
        (sleep 5 && lxc exec v1 -- bash -c "kill -s ${signal} \$(pgrep sleep)") &
        lxc exec v1 -- sleep 60 || exitCode=$?
        # Check exit code, should be 128 plus signal number, 1 for SIGHUP, 9 for SIGKILL and 15 for SIGTERM.
        [ "${exitCode:-0}" -eq $((128 + code)) ]
    done

    echo "==> Test lxc exec exit code when stopping the VM abruptly"
    # XXX: intentionally not using 'prepare_vm_for_hard_stop v1' here as that would
    #      kill the lxd-agent inside the VM.
    (sleep 5 && lxc stop -f v1) &
    lxc exec v1 -- sleep 60 || exitCode=$?
    [ "${exitCode:-0}" -eq 129 ]
    wait $!

    echo "==> Test what happens when the connection with the agent is severed"
    lxc start v1
    waitInstanceBooted v1
    # Simulates what happens during lxc stop.
    # killall is not included in minimal images so we use escaping to combine pgrep and kill.
    lxc exec v1 -- bash -c "kill -s SIGTERM \$(pgrep lxd-agent)" || exitCode=$?
    [ "${exitCode:-0}" -eq 129 ]
fi

# Cleanup
prepare_vm_for_hard_stop v1
lxc delete -f v1

if [ "$(uname -m)" != "x86_64" ]; then
    echo "==> SKIP: emulated VMs are only supported on x86_64"
elif ! lxc query /1.0 | jq --exit-status '(.environment.vm_emulated_architectures // []) | contains(["riscv64", "armv7l"])'; then
    echo "==> SKIP: the LXD snap does not support emulated riscv64 and armv7l VMs"
else
    for pair in riscv64:riscv64 armhf:armv7l; do
        IFS=: read -r image_arch lxd_arch <<< "${pair}"
        echo "==> Test emulated ${lxd_arch} VM"

        image="ubuntu-daily:26.04/${image_arch}"
        if [ -e "${IMAGE_CACHE_DIR:-}/ubuntu-${image_arch}.img" ]; then
            image="ubuntu-vm-${image_arch}"
            lxc image import --quiet "${IMAGE_CACHE_DIR}/ubuntu-${image_arch}.metadata" "${IMAGE_CACHE_DIR}/ubuntu-${image_arch}.img" --alias "${image}"
        fi

        lxc launch "${image}" v-emu --vm -c boot.mode=uefi-nosecureboot -c limits.cpu=2
        lxc query /1.0/instances/v-emu | jq --exit-status --arg arch "${lxd_arch}" '.architecture == $arch'
        grep -xF 'accel = "tcg"' /var/snap/lxd/common/lxd/logs/v-emu/qemu.conf

        # Without a working lxd-agent, the IPv4 address comes from the DHCP leases and SSH shows the guest booted.
        ipv4=""
        for _ in $(seq 300); do
            ipv4="$(lxc list -f csv -c 4 v-emu | cut -d' ' -f1)"
            [ -n "${ipv4}" ] && break
            sleep 1
        done

        if [ -z "${ipv4}" ] || ! waitTCPPort "${ipv4}" 22 open 300 1; then
            echo "::error::Emulated ${lxd_arch} VM did not become reachable over SSH"
            lxc console v-emu --show-log || true
            false
        fi

        fingerprint="$(lxc config get v-emu volatile.base_image)"
        lxc delete -f v-emu
        lxc image delete "${fingerprint}"
    done
fi

# shellcheck disable=SC2034
FAIL=0
