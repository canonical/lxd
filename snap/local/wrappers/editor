#!/bin/sh
run_cmd() {
    CMD="$1"
    shift

    # Host editors must not load Python code or configuration from the snap.
    unset LD_LIBRARY_PATH PYTHONPATH PYTHONDONTWRITEBYTECODE PYTHONHOME PYTHONSTARTUP
    export PYTHONNOUSERSITE=1
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    # Avoid replacing HOME with an empty value, which can redirect editor
    # configuration lookups to the current directory.
    if [ -n "${SNAP_REAL_HOME:-}" ]; then
        export HOME="${SNAP_REAL_HOME}"
    fi

    export USER="${USERNAME}"
    # Compare the basename so absolute nano paths get the same safeguard.
    if [ "${HOME}" != "/root" ] && [ "${CMD##*/}" = "nano" ]; then
        export XDG_DATA_HOME="${HOME}/.local/share"
        if [ ! -d "/var/lib/snapd/hostfs/${XDG_DATA_HOME}" ]; then
            echo "Instructing nano to ignore RC files due to missing directory: \"${XDG_DATA_HOME}\""
            set -- "--ignorercfiles" "$@"
        fi
    fi

    # Use --propagation slave so unmounts in the parent namespace propagate to
    # the editor's namespace. This prevents leftover mounts (ZFS/LVM) from
    # blocking storage delete operations while the editor is open.
    # Pass the command positionally so it is never interpreted as shell syntax.
    exec unshare --kill-child -U -m --propagation slave -p -r -f --root="/var/lib/snapd/hostfs/" \
        "/bin/sh" -c 'mount -t proc proc /proc 2>/dev/null || true; exec "$@"' _ "${CMD}" "$@"
}

# Detect base name
SNAP_BASE="$(sed -n '/^name:/ s/^name:\s*\(core[0-9]\{2\}\)/\1/p' /meta/snap.yaml)"

USERNS=1
[ -e /proc/sys/kernel/unprivileged_userns_clone ] && grep -qxF 0 /proc/sys/kernel/unprivileged_userns_clone && USERNS=0
[ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ] && grep -qxF 1 /proc/sys/kernel/apparmor_restrict_unprivileged_userns && USERNS=0

find_and_spawn() {
    # Resolve absolute editor paths below hostfs before searching PATH-like
    # locations for bare command names.
    case "${1}" in
        /*)
            if [ -e "/var/lib/snapd/hostfs${1}" ] || [ -L "/var/lib/snapd/hostfs${1}" ]; then
                run_cmd "$@"
            fi

            return
            ;;
        *)
            ;;
    esac

    for path in / /usr/ /usr/local/; do
        if [ -e "/var/lib/snapd/hostfs/${path}bin/${1}" ] || [ -L "/var/lib/snapd/hostfs/${path}bin/${1}" ]; then
            run_cmd "$@"
        fi
    done
}

if [ -n "${LXD_EDITOR:-}" ]; then
    EDIT_PATH="${1}"
    EDIT_IFS="${IFS}"
    unset IFS
    set -f
    # Split the configured command on whitespace without globbing or evaluating
    # metacharacters as shell syntax.
    # shellcheck disable=SC2086
    set -- ${LXD_EDITOR}
    set +f
    IFS="${EDIT_IFS}"
    EDIT_CMD="${1:-}"
    [ "$#" -eq 0 ] || shift
    EDIT_FROM_ENV=1
else
    EDIT_FROM_ENV=0
    EDIT_CMD="${1}"
    EDIT_PATH="${2}"
    if [ -z "${EDIT_PATH}" ] || [ "$#" -ge "3" ]; then
        EDIT_CMD=""
        for arg in "$@"; do
            EDIT_PATH="${arg}"
        done
    fi
fi

# Default to trying nano if no editor is provided
if [ -z "${EDIT_CMD}" ]; then
    EDIT_CMD="nano"
fi

# Try running the editor through the host.
if [ -n "${EDIT_CMD}" ] && [ "${USERNS}" = 1 ]; then
    exec 9< /tmp/
    # Replace "/tmp/" prefix by exec'ed FD 9.
    EDIT_PATH_HOST="/proc/self/fd/9/${EDIT_PATH##*/}"
    if [ "${EDIT_FROM_ENV}" = 1 ]; then
        find_and_spawn "${EDIT_CMD}" "$@" "${EDIT_PATH_HOST}"
    else
        find_and_spawn "${EDIT_CMD}" "${EDIT_PATH_HOST}"
    fi

fi

# Fallback to using vim.tiny from base snap

# Search for a vimrc
for vimrc in "${SNAP_USER_COMMON}/.vimrc" "/snap/${SNAP_BASE}/current/etc/vim/vimrc"; do
    [ -r "${vimrc}" ] || continue
    export VIMINIT="source ${vimrc}"
done

# Ignore vimrc if none was found to be readable.
EDIT_IGNORE_RC=""
if [ -z "${VIMINIT:-""}" ]; then
    EDIT_IGNORE_RC="--clean"
fi

# Run the editor.
if [ -n "${EDIT_IGNORE_RC}" ]; then
    exec vim.tiny -Z "${EDIT_IGNORE_RC}" "${EDIT_PATH}"
fi

exec vim.tiny -Z "${EDIT_PATH}"
